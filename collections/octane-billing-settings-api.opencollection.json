          },
          "docs": "Get all payment gateway credentials for a vendor."
        },
        {
          "info": {
            "name": "Create Payment Gateway Credential",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getoctane.io/payment_gateway_credentials",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add payment gateway credentials for a vendor."
