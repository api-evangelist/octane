{
  "opencollection": "1.0.0",
  "info": {
    "name": "Octane REST Admin Customer Portal API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Portal",
        "type": "folder"
      },
      "items": [
