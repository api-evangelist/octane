          "http": {
            "method": "GET",
            "url": "https://api.getoctane.io/customer_portal_settings"
          },
          "docs": "Get the customer portal configuration."
        },
        {
          "info": {
            "name": "Create Customer Portal Settings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getoctane.io/customer_portal_settings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create customer portal configuration."
        },
        {
          "info": {
            "name": "Get ECP Active Subscription",
            "type": "http"
