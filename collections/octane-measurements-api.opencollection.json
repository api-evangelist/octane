{
  "opencollection": "1.0.0",
  "info": {
    "name": "Octane REST Admin Measurements API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Measurements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send Measurement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getoctane.io/measurements",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a single usage measurement for a customer."
        },
        {
          "info": {
            "name": "Send Batched Measurements",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getoctane.io/measurements/multi",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit multiple usage measurements in a single request."
        }
      ]
    }
  ],
  "bundled": true
}