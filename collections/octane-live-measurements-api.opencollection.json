{
  "opencollection": "1.0.0",
  "info": {
    "name": "Octane REST Admin Live Measurements API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Live Measurements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Live Measurements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getoctane.io/live_measurements"
          },
          "docs": "Retrieve real-time usage measurements."
        }
      ]
    }
  ],
  "bundled": true
}