{
  "opencollection": "1.0.0",
  "info": {
    "name": "Octane REST Admin API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Roll API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getoctane.io/admin/api_key/roll"
          },
          "docs": "Generate a new API key, invalidating the existing one."
        }
      ]
    }
  ],
  "bundled": true
}